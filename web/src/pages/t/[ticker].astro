---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import { renderTicker } from "@/lib/render-ticker";
import { loadScores } from "@/lib/scores";
import { unpaged } from "@/lib/screener";
import { loadTickers } from "@/lib/tickers";

export const getStaticPaths = (() => {
  const reports = loadTickers();
  const missing = unpaged(loadScores(), reports);
  if (missing.length > 0)
    throw new Error(
      `${missing.length} scored tickers have no ticker report, so the build would leave them without a page: ${missing.join(", ")}. Run \`eq export\` and build again.`,
    );
  return reports.map((report) => ({
    params: { ticker: report.ticker },
    props: { report },
  }));
}) satisfies GetStaticPaths;

const { report } = Astro.props;
---

<Layout title={`${report.ticker} · index`}>
  <main class="container mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <p
      class="border-warning bg-warning/10 text-foreground rounded-md border px-4 py-3 text-sm font-medium"
      role="note"
    >
      Experimental, not validated. Nothing here is investment advice or a
      recommendation to buy or sell a security.
    </p>

    <div id="ticker-root" set:html={renderTicker(report)} />
  </main>
</Layout>
