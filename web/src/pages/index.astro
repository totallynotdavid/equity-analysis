---
import Layout from "@/layouts/Layout.astro";
import { loadScores } from "@/lib/scores";

const scores = loadScores();
---

<Layout>
  <main class="container mx-auto max-w-3xl px-4 py-12 sm:py-20">
    <h1 class="text-primary text-5xl font-bold tracking-tight sm:text-6xl">
      index
    </h1>
    <p class="text-muted-foreground mt-3 text-base">
      A daily score from 1 to 10 for US stocks. Internal tool.
    </p>

    <p
      class="border-warning bg-warning/10 text-foreground mt-8 rounded-md border px-4 py-3 text-sm font-medium"
      role="note"
    >
      Experimental, not validated. Nothing here is investment advice or a
      recommendation to buy or sell a security. You can lose money.
    </p>

    {scores === null ? (
      <p class="text-muted-foreground mt-8 text-sm">
        No scores yet. Run <code>eq run</code> and build again.
      </p>
    ) : (
      <>
        {scores.source !== "tiingo" && (
          <p
            class="border-error bg-error/10 text-foreground mt-4 rounded-md border px-4 py-3 text-sm font-medium"
            role="alert"
          >
            These scores come from {scores.source} prices, not market data. They
            mean nothing.
          </p>
        )}
        <p class="text-muted-foreground mt-8 text-sm">
          As of {scores.as_of}. Score 10 is the top tenth of{" "}
          {scores.rows.length}
          stocks by estimated chance of beating the S&amp;P 500 over the next{" "}
          {scores.horizon_days} trading days.
        </p>
        <table class="mt-3 w-full text-left text-sm" id="scores">
          <thead class="text-muted-foreground border-b">
            <tr>
              <th class="py-2 pr-4 font-medium">Rank</th>
              <th class="py-2 pr-4 font-medium">Ticker</th>
              <th class="py-2 text-right font-medium">Score</th>
            </tr>
          </thead>
          <tbody>
            {scores.rows.map((row) => (
              <tr class="border-b last:border-0">
                <td class="py-2 pr-4 tabular-nums">{row.rank}</td>
                <td class="py-2 pr-4 font-medium">{row.ticker}</td>
                <td class="py-2 text-right tabular-nums">{row.score}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}
  </main>
</Layout>
