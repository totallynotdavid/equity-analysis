---
import Layout from "@/layouts/Layout.astro";
import { loadEvidence } from "@/lib/evidence";
import { leftOutNote, modelNote, sourcesWarning } from "@/lib/render";
import {
  buildScreener,
  parseState,
  renderControls,
  renderResults,
  renderScoreNote,
} from "@/lib/screener";
import { loadScores } from "@/lib/scores";
import { loadTickers } from "@/lib/tickers";

const scores = loadScores();
const data = buildScreener(scores, loadTickers(), loadEvidence());
const state = parseState("", data);
// A `<` in the data must not end the script element that holds it.
const json = JSON.stringify(data).replaceAll("<", "\\u003c");
---

<Layout>
  <main class="container mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <h1 class="text-primary text-5xl font-bold tracking-tight sm:text-6xl">
      index
    </h1>
    <p class="text-muted-foreground mt-3 text-base">
      Screen US stocks by their filed fundamentals. Internal tool.
    </p>

    <p
      class="border-warning bg-warning/10 text-foreground mt-8 rounded-md border px-4 py-3 text-sm font-medium"
      role="note"
    >
      Experimental, not validated. Nothing here is investment advice or a
      recommendation to buy or sell a security. You can lose money.
    </p>

    {scores !== null && (
      <Fragment
        set:html={
          sourcesWarning(scores) + leftOutNote(scores) + modelNote(scores)
        }
      />
    )}
    <Fragment set:html={renderScoreNote(data)} />

    {data.rows.length === 0 ? (
      <p class="text-muted-foreground mt-8 text-sm">
        No ticker reports yet. Run <code>eq run</code> and build again.
      </p>
    ) : (
      <div id="screener">
        <p class="text-muted-foreground mt-6 text-sm">
          As of {data.asOf}, {data.rows.length} stocks of the {data.universe}{" "}
          universe. The latest filed figure of each metric is shown. Click a
          heading to sort. The address holds the filters, so a copied link opens
          the same table.
        </p>
        <div id="screener-controls" set:html={renderControls(data, state)} />
        <div id="screener-results" set:html={renderResults(data, state)} />
        <script
          is:inline
          type="application/json"
          id="screener-data"
          set:html={json}
        />
      </div>
    )}
  </main>
</Layout>

<script>
  import { mount } from "@/lib/screener-client";
  import type { ScreenerData } from "@/lib/screener";

  const controls = document.getElementById("screener-controls");
  const results = document.getElementById("screener-results");
  const json = document.getElementById("screener-data");
  if (controls && results && json)
    mount(controls, results, JSON.parse(json.textContent) as ScreenerData);
</script>
