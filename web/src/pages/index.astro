---
import Layout from "@/layouts/Layout.astro";
import { renderScores } from "@/lib/render";
import { loadScores } from "@/lib/scores";

const scores = renderScores(loadScores());
---

<Layout>
  <main class="container mx-auto max-w-3xl px-4 py-12 sm:py-20">
    <h1 class="text-primary text-5xl font-bold tracking-tight sm:text-6xl">
      index
    </h1>
    <p class="text-muted-foreground mt-3 text-base">
      A daily score from 1 to 10 for US stocks. Internal tool.
    </p>

    <p
      class="border-warning bg-warning/10 text-foreground mt-8 rounded-md border px-4 py-3 text-sm font-medium"
      role="note"
    >
      Experimental, not validated. Nothing here is investment advice or a
      recommendation to buy or sell a security. You can lose money.
    </p>

    <div id="scores-root" set:html={scores} />
  </main>
</Layout>

<script>
  import { renderScores } from "@/lib/render";

  // The build-time scores stay when the API is absent, as in `mise run web`.
  const base = import.meta.env.PUBLIC_API_URL ?? "/api";
  const root = document.getElementById("scores-root");
  fetch(`${base}/scores`)
    .then((response) => (response.ok ? response.json() : null))
    .then((scores) => {
      if (scores && root) root.innerHTML = renderScores(scores);
    })
    .catch(() => {});
</script>
