---
import "@/styles/global.css";
import "@/styles/starwind.css";

interface Props {
  title?: string;
}

const { title = "index" } = Astro.props;

const links = [
  { href: "/", label: "Screener" },
  { href: "/evidence", label: "Evidence" },
  { href: "/method", label: "Method" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="index: a daily score for US stocks" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    <nav
      class="container mx-auto flex max-w-6xl gap-6 px-4 pt-6 text-sm"
      aria-label="Pages"
    >
      {links.map(({ href, label }) => (
        <a
          class="underline-offset-4 hover:underline"
          href={href}
          aria-current={Astro.url.pathname === href ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <slot />
  </body>
</html>
